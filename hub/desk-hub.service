[Unit]
Description=Desk Hub (personal AI assistant, reachable from other devices)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust to your install path + user. The sed below MUST use /g: this file
# mentions /opt/desk three times (WorkingDirectory + two ReadWritePaths), and
# replacing only the first occurrence leaves systemd trying to bind a path that
# does not exist -> "Failed to set up mount namespacing", exit 226/NAMESPACE.
#   sudo sed -i "s#/opt/desk#$HOME/desk#g; s/User=desk/User=$USER/; s/Group=desk/Group=$USER/" /etc/systemd/system/desk-hub.service
#   sudo systemctl daemon-reload && sudo systemctl restart desk-hub
WorkingDirectory=/opt/desk
User=desk
Group=desk

Environment=HOST=0.0.0.0
Environment=ASSIST_ALLOW_REMOTE=1
Environment=PORT=4390
# Headless box: no X server, so the browser runs windowless
Environment=BROWSER_HEADLESS=1
# Optional: pin a browser binary
# Environment=CHROME_PATH=/usr/bin/chromium

ExecStart=/usr/bin/node src/server.mjs
Restart=always
RestartSec=3

# Hardening: the agent runs tools, so keep the blast radius small.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=/opt/desk/data /opt/desk/workspace

[Install]
WantedBy=multi-user.target
